  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ensure-auth": "ts-node scripts/ensureTestAuthUsers.ts",
    "bench:library": "tsx scripts/bench-library.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aniquizz/database": "workspace:*",
    "@aniquizz/shared": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.93.1",
    "axios": "^1.13.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fastest-levenshtein": "^1.0.16",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "p-limit": "^7.2.0",
    "pino": "^9.14.0",
    "socket.io": "^4.8.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "socket.io-client": "^4.8.2",
    "vitest": "^4.1.10",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
