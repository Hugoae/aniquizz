# Server (Express + Socket.io) environment. Copy to apps/server/.env
PORT=3001
CLIENT_URL=http://localhost:8080
# Production (Render): https://aniquizz.com
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional legacy HS256 fallback; integration tests prefer sign-in via anon key + TEST_ACCOUNTS_PASSWORD.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Copied from apps/client VITE_SUPABASE_ANON_KEY for integration test sign-in.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Shared password for @aniquizz.test auth users (dev/CI only). Generate with: pnpm rotate-test-credentials
TEST_ACCOUNTS_PASSWORD=
# Optional: fatal|error|warn|info|debug|trace|silent (defaults: info prod, debug dev)
LOG_LEVEL=debug
