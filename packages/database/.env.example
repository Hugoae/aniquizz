# Database + ETL pipeline environment. Copy to packages/database/.env
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public
# Cloudflare R2 (media hosting, wired in Phase 1)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=aniquizz-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# --- Step 1: AniList fetch (most-popular-first) ---
# How many anime roots to fetch. Run small first (e.g. 30), scale later (e.g. 500).
ANILIST_LIMIT=500
ANILIST_PER_PAGE=50
ANILIST_DELAY_MS=1000
# Skip sequel API walks (fast incremental re-runs). See packages/database/README.md.
# ANILIST_SKIP_SEQUELS=1          # skip locked + new franchise sequel expansion
# ANILIST_SKIP_LOCKED_SEQUELS=1     # skip only locked-franchise sequel walk (phase 1b)
# ANILIST_SKIP_NEW_SEQUELS=1        # skip only new-franchise sequel walk (phase 4)
# --- Step 2: AnimeThemes fetch ---
ANIMETHEMES_DELAY_MS=200
# Which theme types to import (comma-separated): OP, ED, INSERT. Default OP-only.
# The cache stores every theme, so widening this later just re-parses the cache.
SONG_TYPES=OP
# Input file inside data/ (default: data_step1.json). Use manual_edits.json for
# a targeted backfill against the current exported DB catalogue.
# ANIMETHEMES_INPUT_FILE=manual_edits.json
# Selection scope (choose at most one TOP_LIMIT or TARGET_IDS):
# - TOP_LIMIT: live AniList POPULARITY_DESC, restricted to eligible input rows;
#   locked rows are included and absent/excluded ids are replaced by the next rank.
# - TARGET_IDS: exact AniList ids, including locked rows.
# - INCLUDE_LOCKED: all rows from the input instead of the default unlocked-only set.
# ANIMETHEMES_TOP_LIMIT=100
# ANIMETHEMES_TARGET_IDS=16498,101922
# ANIMETHEMES_INCLUDE_LOCKED=1
# Preview selection without AnimeThemes requests or local output/cache writes.
# ANIMETHEMES_DRY_RUN=1
# --- Step 4: R2 worker tuning ---
# Retries transient download ERRORs to PENDING; permanent failures (ffmpeg, corrupt) -> SKIPPED.
RESET_ERRORS_ON_START=true
# Explicit retry escape hatches for rows already marked SKIPPED. Bulk retry
# preserves deliberate WORKER_SKIP_VIDEO_KEYS exclusions; exact keys override them.
RETRY_SKIPPED_ON_START=false
# WORKER_RETRY_VIDEO_KEYS=OnePiece-21-ED25.mp4
WORKER_CONCURRENCY=3
WORKER_DOWNLOAD_TIMEOUT_MS=60000
WORKER_COMPRESS_TIMEOUT_MS=120000
# Download retry/backoff (AnimeThemes CDN returns 503 on bursts). Retries use
# exponential backoff + jitter and honor Retry-After on 429/503.
WORKER_DOWNLOAD_RETRIES=4
WORKER_RETRY_BASE_MS=2000
# Optional: only download songs whose sourceUrl contains this substring. Set to
# "animethemes.moe" to skip stale sources (e.g. the retired Supabase bucket).
WORKER_SOURCE_INCLUDE=
# Comma-separated videoKeys to skip (mark SKIPPED). Example: NANA-877-OP1.mp4
# WORKER_SKIP_VIDEO_KEYS=NANA-877-OP1.mp4
# Dev-only: number of openings seeded by `seed:dev-catalogue`
DEV_SEED_LIMIT=10
