# Database + ETL pipeline environment. Copy to packages/database/.env
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public
# Cloudflare R2 (media hosting, wired in Phase 1)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=aniquizz-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# --- Step 1: AniList fetch (most-popular-first) ---
# How many anime roots to fetch. Run small first (e.g. 30), scale later (e.g. 500).
ANILIST_LIMIT=500
ANILIST_PER_PAGE=50
ANILIST_DELAY_MS=1000
# --- Step 2: AnimeThemes fetch ---
ANIMETHEMES_DELAY_MS=200
# Which theme types to import (comma-separated): OP, ED, INSERT. Default OP-only.
# The cache stores every theme, so widening this later just re-parses the cache.
SONG_TYPES=OP
# --- Step 4: R2 worker tuning ---
RESET_ERRORS_ON_START=true
WORKER_CONCURRENCY=3
WORKER_DOWNLOAD_TIMEOUT_MS=60000
WORKER_COMPRESS_TIMEOUT_MS=120000
# Download retry/backoff (AnimeThemes CDN returns 503 on bursts). Retries use
# exponential backoff + jitter and honor Retry-After on 429/503.
WORKER_DOWNLOAD_RETRIES=4
WORKER_RETRY_BASE_MS=2000
# Optional: only download songs whose sourceUrl contains this substring. Set to
# "animethemes.moe" to skip stale sources (e.g. the retired Supabase bucket).
WORKER_SOURCE_INCLUDE=
# Dev-only: number of openings seeded by `seed:dev-catalogue`
DEV_SEED_LIMIT=10
