{
  "name": "aniquizz",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time anime opening blind-test game (React + Express + Socket.io monorepo)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @aniquizz/database exec prisma generate",
    "db:migrate": "pnpm --filter @aniquizz/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @aniquizz/database exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
