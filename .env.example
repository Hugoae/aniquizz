# =============================================================================
# AniQuizz - environment reference
# =============================================================================
# This is a documentation-only reference of every variable used across the
# monorepo. Each package reads its own .env file. Copy the relevant block into:
#   - apps/client/.env       (Vite, VITE_* vars only)
#   - apps/server/.env       (Express + Socket.io)
#   - packages/database/.env (Prisma + ETL pipeline)
# Never commit real .env files.

# --- Shared ---
NODE_ENV=development

# --- Client (apps/client/.env) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SERVER_URL=http://localhost:3001
# Public media base URL (Cloudflare R2, wired in Phase 1)
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Server (apps/server/.env) ---
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT verification for Socket.io handshake (wired in Phase 2)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Database / ETL pipeline (packages/database/.env) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cloudflare R2 (wired in Phase 1)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=aniquizz-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
