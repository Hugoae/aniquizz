# Client (Vite) environment. Copy to apps/client/.env
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SERVER_URL=http://localhost:3001
# Public media base URL (Cloudflare R2, wired in Phase 1)
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Optional: canonical site URL for SEO (defaults to https://aniquizz.com in production builds)
VITE_SITE_URL=https://aniquizz.com
# Optional: enable client error reporting in production builds (console for now)
VITE_DEBUG_REPORTING=false
