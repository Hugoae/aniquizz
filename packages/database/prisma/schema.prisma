generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum DownloadStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  SKIPPED
}

enum SongType {
  OP
  ED
  INSERT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum GameMode {
  STANDARD
  SPRINT
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum AnswerType {
  TYPING
  QCM
  DUO
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

// Match setting snapshots (reserved for future profile charts — migration applied, feature deferred).
enum StoredResponseType {
  TYPING
  QCM
  MIX
}

enum StoredPrecision {
  FRANCHISE
  ANIME
  ARTIST
}

enum StoredSoloMedal {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum SuggestionCategory {
  IMPROVEMENT
  SONG_REQUEST
  CORRECTION
  OTHER
}

enum SuggestionStatus {
  OPEN
  PLANNED
  DONE
  REJECTED
}

enum SuggestionCorrectionField {
  TITLE
  ARTIST
  DIFFICULTY
  OTHER
}

enum DailyChallengeStatus {
  DRAFT
  READY
  CANCELLED
}

enum DailyAttemptState {
  IN_PROGRESS
  COMPLETED
  FORFEITED
  /// Leftover from the abandoned 15-minute attempt budget. New runs use FORFEITED or COMPLETED.
  EXPIRED
}

// --- IDENTITY ---
model Profile {
  // = auth.users.id — populated by the Supabase `handle_new_user()` trigger.
  id       String @id
  username String @unique
  email    String @unique
  avatar   String @default("default_avatar.png")

  level Int @default(1)
  xp    Int @default(0)

  // Privacy audiences (v26.6) — server-enforced; never trust the client.
  onlineStatusAudience  String  @default("everyone")
  matchHistoryAudience  String  @default("everyone")
  lobbyInviteAudience   String  @default("friends")

  anilistUsername String?
  malUsername     String?
  lastListSync    DateTime?
  activeListProvider String?
  anilistLastSync    DateTime?
  malLastSync        DateTime?

  role UserRole @default(USER)

  // Admin moderation (Phase 6). Null = not banned / not muted.
  bannedUntil DateTime?
  mutedUntil  DateTime?
  // Presence heartbeat (used by admin now; friends presence in Phase 7).
  lastSeenAt  DateTime?
  // Friends privacy (Phase 7): when false, the user refuses all incoming friend requests.
  allowFriendRequests Boolean @default(true)
  // When false, the favorites section is hidden on the public profile.
  showFavoriteSongs    Boolean @default(true)
  // Player comfort prefs (v26.6) — lobby/room settings stay host-scoped.
  audioVolume            Int     @default(20)
  audioMuted             Boolean @default(false)
  motionMode             String  @default("auto")
  autofocusAnswer        Boolean @default(true)
  submitOnEnter          Boolean @default(true)
  soloAutoReveal         Boolean @default(false)
  showShortcutReminder   Boolean @default(true)
  friendRequestVisual    Boolean @default(true)
  friendRequestSound     Boolean @default(false)
  lobbyInviteVisual      Boolean @default(true)
  lobbyInviteSound       Boolean @default(false)

  gamesPlayed    Int @default(0)
  gamesWon       Int @default(0)
  totalGuesses   Int @default(0)
  correctGuesses Int @default(0)
  maxStreak      Int @default(0)
  // Consecutive won matches (Phase 7 XP win-streak bonus): +1 on win, reset on loss.
  currentWinStreak Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchPlayers MatchPlayer[]
  history      SongHistory[]
  songLikes    SongLike[]
  suggestions  Suggestion[]
  suggestionVotes SuggestionVote[]
  myList       PlayerAnimeList[]
  // Social (Phase 7). Friendship rows where this profile is the requester / addressee.
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")
  dailyAttempts    DailyAttempt[]
  dailyStats       DailyPlayerStats?
  reviewedDailyChallenges DailyChallenge[] @relation("DailyReviewer")

  @@index([xp(sort: Desc), level(sort: Desc)])
  @@index([gamesWon(sort: Desc)])
  @@index([gamesPlayed(sort: Desc)])
  // Accuracy ranking uses a partial expression index (numeric ratio); see migrations.
  @@index([lastSeenAt])
}

// --- SOCIAL (Phase 7) ---
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester Profile @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Profile @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  // One row per ordered pair; the service also guards the reverse direction.
  @@unique([requesterId, addresseeId])
  // Incoming-requests lookup ("who wants to friend me").
  @@index([addresseeId, status])
}

// --- MATCH PERSISTENCE (Phase 5, replaces GameSession/GameParticipant) ---
model Match {
  id          String      @id @default(uuid())
  mode        GameMode    @default(STANDARD)
  status      MatchStatus @default(IN_PROGRESS)
  totalRounds Int
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  responseType StoredResponseType?
  precision    StoredPrecision?
  /** Staff thematic playlist used as the music source, if any (v26.5 stats). */
  playlistId   String?
  /** Decade overlay when the match combined a genre pack with a decade pack. */
  decadePlaylistId String?

  players  MatchPlayer[]
  rounds   MatchRound[]
  playlist ThematicPlaylist? @relation("MatchPrimaryPlaylist", fields: [playlistId], references: [id], onDelete: SetNull)
  decadePlaylist ThematicPlaylist? @relation("MatchDecadePlaylist", fields: [decadePlaylistId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@index([playlistId])
  @@index([decadePlaylistId])
}

model MatchPlayer {
  id           String  @id @default(uuid())
  matchId      String
  profileId    String
  score        Int     @default(0)
  rank         Int?
  isWinner     Boolean @default(false)
  correctCount Int     @default(0)
  xpEarned     Int     @default(0)
  soloMedal    StoredSoloMedal?

  match   Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers RoundAnswer[]

  @@unique([matchId, profileId])
  @@index([profileId])
}

model MatchRound {
  id          String   @id @default(uuid())
  matchId     String
  roundNumber Int
  // Nullable so deleting a song does not wipe match history.
  songId      Int?
  startedAt   DateTime @default(now())

  match   Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  song    Song?         @relation(fields: [songId], references: [id], onDelete: SetNull)
  answers RoundAnswer[]

  @@unique([matchId, roundNumber])
  @@index([songId])
}

model RoundAnswer {
  id            String     @id @default(uuid())
  roundId       String
  matchPlayerId String
  answer        String?
  isCorrect     Boolean    @default(false)
  answerType    AnswerType
  // Time-to-answer in ms (stats + future speed mode).
  timeMs        Int?
  pointsAwarded Int        @default(0)
  answeredAt    DateTime   @default(now())

  round       MatchRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  matchPlayer MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundId, matchPlayerId])
  @@index([matchPlayerId])
}

// --- CATALOGUE ---
model Franchise {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  genres         String[]
  /** Max AniList popularity among linked animes — denormalized for library sort. */
  maxPopularity  Int      @default(0)
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  animes         Anime[]

  @@index([maxPopularity(sort: Desc)])
  @@index([genres], type: Gin)
}

model Anime {
  id          Int      @id @default(autoincrement())
  name        String
  altNames    String[]
  siteUrl     String?
  studio      String?
  coverImage  String?
  // Dominant cover color (AniList coverImage.color) for UI theming.
  coverColor  String?
  // AniList banner image URL.
  bannerImage String?
  // AniList synopsis (raw HTML as returned by AniList).
  description String?
  popularity  Int      @default(0)
  // AniList average score (0-100).
  averageScore Int?
  // Total episode count (AniList).
  episodes    Int?
  // AniList release season: WINTER / SPRING / SUMMER / FALL.
  season      String?
  // MyAnimeList id, provided directly by AniList (no matching needed). Nullable.
  idMal       Int?
  tags        String[]
  format      String?
  status      String?
  seasonYear  Int?
  franchiseId Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  songs       Song[]
  playerLists PlayerAnimeList[]

  @@index([franchiseId])
  @@index([popularity(sort: Desc)])
  @@index([idMal])
}

model Song {
  id             Int            @id @default(autoincrement())
  title          String
  /** Display credit — collaborations stay joined with ", ". */
  artist         String
  /**
   * Credited people/units for artist-precision answers.
   * One name for a band (even with a comma in the title); several for a collab.
   */
  artistNames    String[]       @default([])
  songType       SongType
  sequence       Int            @default(1)
  videoKey       String         @unique
  tags           String[]
  sourceUrl      String?
  duration       Int?
  difficulty     Difficulty     @default(MEDIUM)
  episodeRange   String?
  animeId        Int
  isLocked       Boolean        @default(false)
  downloadStatus DownloadStatus @default(PENDING)
  errorLog       String?
  /** Denormalized count of SongLike rows; maintained on like/unlike. */
  likeCount      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  anime   Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  history SongHistory[]
  likes   SongLike[]
  suggestions Suggestion[]
  rounds  MatchRound[]
  thematicPlaylists ThematicPlaylistSong[]
  dailyRounds       DailyChallengeRound[]

  @@index([animeId])
  @@index([downloadStatus])
  @@index([difficulty])
  // Composite for the playlist candidate scan (always filters COMPLETED, often by
  // type + difficulty). Speeds match-start selection as the catalogue grows.
  @@index([downloadStatus, songType, difficulty])
  @@index([tags], type: Gin)
}

model SongHistory {
  id           String   @id @default(uuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  songId       Int
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  playCount    Int      @default(1)
  correctCount Int      @default(0)
  lastPlayedAt DateTime @default(now())

  @@unique([profileId, songId])
  @@index([songId])
}

/// User-curated favorite songs (explicit like — distinct from SongHistory "heard").
model SongLike {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  songId    Int
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  likedAt   DateTime @default(now())
  /** 1–5 when pinned for public profile showcase; null = not showcased. */
  pinOrder  Int?

  @@unique([profileId, songId])
  @@unique([profileId, pinOrder])
  @@index([profileId, likedAt(sort: Desc)])
  @@index([profileId, pinOrder])
  @@index([songId])
}

model Suggestion {
  id              String                     @id @default(uuid())
  authorId        String?
  author          Profile?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category        SuggestionCategory
  status          SuggestionStatus           @default(OPEN)
  statusRank      Int                        @default(0)
  title           String
  body            String
  songId          Int?
  song            Song?                      @relation(fields: [songId], references: [id], onDelete: SetNull)
  correctionField SuggestionCorrectionField?
  proposedValue   String?
  voteCount       Int                        @default(0)
  adminReply      String?
  adminRepliedAt  DateTime?
  staffTreatedAt  DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  votes           SuggestionVote[]

  @@index([statusRank, voteCount(sort: Desc), createdAt(sort: Desc)])
  @@index([category, status])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([songId])
  @@index([staffTreatedAt])
}

model SuggestionVote {
  id           String     @id @default(uuid())
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([suggestionId, profileId])
  @@index([profileId, createdAt(sort: Desc)])
}

/// Server-only sliding window used by HTTP rate limits (survives restarts).
model HttpRateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model PlayerAnimeList {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  animeId   Int
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, animeId])
  @@index([animeId])
}

/// Staff-curated music pack (v26.5). Recipe is resolved into a frozen snapshot on publish.
model ThematicPlaylist {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  description   String    @default("")
  category      String    @default("theme")
  recipe        Json
  isPublished   Boolean   @default(false)
  snapshotAt    DateTime?
  snapshotCount Int       @default(0)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  songs   ThematicPlaylistSong[]
  matches Match[] @relation("MatchPrimaryPlaylist")
  decadeMatches Match[] @relation("MatchDecadePlaylist")

  @@index([isPublished, sortOrder])
}

model ThematicPlaylistSong {
  playlistId String
  songId     Int
  playlist   ThematicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song             @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([songId])
}

/// Globally shared five-song daily QCM (v26.6). Server-only; see docs/game/daily-quiz.md.
model DailyChallenge {
  id              String               @id @default(uuid())
  /// Paris civil date stored as DATE (YYYY-MM-DD), never inferred by clients.
  challengeDate   DateTime             @unique @db.Date
  challengeNumber Int                  @unique
  status          DailyChallengeStatus @default(DRAFT)
  rulesVersion    Int                  @default(1)
  generatedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Profile?             @relation("DailyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  rounds   DailyChallengeRound[]
  attempts DailyAttempt[]

  @@index([status, challengeDate])
}

model DailyChallengeRound {
  id             String   @id @default(uuid())
  challengeId    String
  position       Int
  songId         Int?
  /// Frozen PlaylistItem-style payload: clip offset, four choices, reveal metadata.
  snapshot       Json
  videoStartTime Int
  choices        String[]
  voided         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge DailyChallenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  song      Song?                @relation(fields: [songId], references: [id], onDelete: SetNull)
  answers   DailyAttemptAnswer[]

  @@unique([challengeId, position])
  @@index([songId])
}

model DailyAttempt {
  id                   String            @id @default(uuid())
  challengeId          String
  profileId            String
  state                DailyAttemptState @default(IN_PROGRESS)
  currentRound         Int               @default(1)
  startedAt            DateTime          @default(now())
  /// Leftover NOT NULL column from the abandoned 15-minute budget. Not a play clock.
  expiresAt            DateTime
  completedAt          DateTime?
  currentRoundStartedAt DateTime?
  revealUntil          DateTime?
  correctCount         Int               @default(0)
  /// Snapshot of playable rounds at settle — voided songs can shrink the day.
  activeRoundCount     Int               @default(5)
  /// Recap victory (`isDailyVictory`) persisted so history/stats stay stable.
  won                  Boolean           @default(false)
  /// Leftover match-score snapshot. Ranking is correct then time, not these points.
  points               Int               @default(0)
  totalResponseMs      Int               @default(0)
  xpAwarded            Int               @default(0)
  /// Live standing among that day's finishers (ties share a rank: 1-2-2-4).
  rank                 Int?

  challenge DailyChallenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile   Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers   DailyAttemptAnswer[]

  @@unique([challengeId, profileId])
  @@index([profileId, startedAt(sort: Desc)])
  @@index([profileId, state, completedAt(sort: Desc)])
  @@index([challengeId, state, correctCount(sort: Desc), totalResponseMs, completedAt])
}

model DailyAttemptAnswer {
  id           String   @id @default(uuid())
  attemptId    String
  roundId      String
  selectedLabel String?
  isCorrect    Boolean  @default(false)
  responseMs   Int      @default(0)
  answeredAt   DateTime @default(now())

  attempt DailyAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  round   DailyChallengeRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([attemptId, roundId])
  @@index([roundId])
}

model DailyPlayerStats {
  profileId          String   @id
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  completions        Int      @default(0)
  wins               Int      @default(0)
  perfectDays        Int      @default(0)
  lastCompletionDate DateTime? @db.Date
  updatedAt          DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
