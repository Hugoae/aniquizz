{
  "name": "@aniquizz/shared",
  "version": "1.0.0",
  "description": "Framework-agnostic types, constants and pure game logic shared by the client and server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mediaPlayback": {
      "types": "./dist/mediaPlayback.d.ts",
      "default": "./dist/mediaPlayback.js"
    }
  },
  "typesVersions": {
    "*": {
      "mediaPlayback": [
        "./dist/mediaPlayback.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
